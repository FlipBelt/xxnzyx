# Add this file as a separate server block to the ECS's existing Nginx setup.
# Replace all example domains before production use.

server {
    listen 80;
    server_name game.example.com;

    root /srv/flipbelt-challenge/participant-h5;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    server_name game-admin.example.com;

    root /srv/flipbelt-challenge/admin;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    server_name game-api.example.com;

    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:8100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
